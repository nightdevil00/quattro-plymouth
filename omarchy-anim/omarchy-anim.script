# Omarchy Plymouth Theme Script - Flying Car Animation Edition

Window.SetBackgroundTopColor(0.101, 0.105, 0.149);
Window.SetBackgroundBottomColor(0.101, 0.105, 0.149);

#----------------------------------------- Helper Functions --------------------------------

fun pad(n, width) {
  s = String(n);
  while (s.Length() < width) {
    s = "0" + s;
  }
  return s;
}

#----------------------------------------- Car Animation -----------------------------------

global.total_frames = 146;
global.animation_frame = 0;
global.car_frame_counter = 0;
global.car_active = 0;
global.password_shown = 0;

car.frames = [];

# Pre-load all frames at startup for smooth, glitch-free animation
for (i = 0; i < global.total_frames; i++) {
  fname = "frame_" + pad(i, 4) + ".png";
  car.frames[i] = Image(fname);
}

car.sprite = Sprite();
if (car.frames[0]) {
  car.sprite.SetImage(car.frames[0]);
  car.w = car.frames[0].GetWidth();
  car.h = car.frames[0].GetHeight();
  car.x = Window.GetWidth() / 2 - car.w / 2;
  car.y = Window.GetHeight() / 2 - car.h / 2;
  car.sprite.SetPosition(car.x, car.y, 5000);
}
car.sprite.SetOpacity(0);

#----------------------------------------- Logo --------------------------------------------

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetPosition(logo.sprite.GetX(), logo.sprite.GetY(), 1000);
logo.sprite.SetOpacity(1);

#----------------------------------------- Password UI -------------------------------------

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = logo.sprite.GetY() + logo.image.GetHeight() + 40;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

# Scale lock to match entry field proportions
lock.image = Image("lock.png");
lock_height = entry.image.GetHeight() * 0.8;
lock_scale = lock_height / 96;
lock_width = 84 * lock_scale;
scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - 15;
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");
bullet.sprites = [];

fun show_password_dialog() {
  global.car_active = 0;
  car.sprite.SetOpacity(0);

  logo.sprite.SetOpacity(1);
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

#----------------------------------------- Callbacks ---------------------------------------

fun refresh_callback() {
  global.animation_frame++;

  if (global.car_active == 1) {
    # Play at 30 FPS (refresh timer runs at 50 FPS)
    frame_num = Math.Int((global.car_frame_counter * 30 / 50) % global.total_frames);
    global.car_frame_counter++;

    if (car.frames[frame_num]) {
      car.sprite.SetImage(car.frames[frame_num]);
    }
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun display_normal_callback() {
  hide_password_dialog();

  # Hide static logo to give full visual focus to the flying car animation
  logo.sprite.SetOpacity(0);

  # Show flying car animation instead of progress bar
  global.car_active = 1;
  car.sprite.SetOpacity(1);
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  show_password_dialog();

  # Clear existing bullets
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  # Render active bullets (max 21)
  max_bullets = 21;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) {
    bullets_to_show = max_bullets;
  }

  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      scaled_bullet = bullet.image.Scale(7, 7);
      bullet.sprites[index] = Sprite(scaled_bullet);
      bx = entry.x + 20 + index * (7 + 5);
      by = entry.y + entry.image.GetHeight() / 2 - 3.5;
      bullet.sprites[index].SetPosition(bx, by, 10002);
    }
    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Progress bar replacement callback
fun progress_callback(duration, progress) {
  # Car animation replaces progress bar completely
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Messages ----------------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text) {
  message = Image.Text(text, 1, 1, 1);
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
